rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /venueData/{venueDoc} {
      allow read, write: if request.auth != null;
    }

    match /backups/{backupDoc} {
      allow read, write: if request.auth != null;
    }

    match /audits/{auditDoc} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
